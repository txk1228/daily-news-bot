# ========================================
# 飞书配置（必填）— 复制本文件为 .env 后填写
#   Windows:  Copy-Item .env.example .env
#   macOS/Linux:  cp .env.example .env
# ========================================

# 【填写 1】飞书群 → 群机器人 → 自定义机器人 → 复制 Webhook 地址
# 示例格式（把 your-webhook-id 换成你自己的）：
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-id

# 【填写 2】同一机器人详情 → 安全设置 → 开启「签名校验」→ 复制密钥
# 不要用下面的占位符，换成飞书生成的真实 secret：
FEISHU_SECRET=your_feishu_signing_secret

# ----------------------------------------
# 主题不通过环境变量配置，请用命令行：
#   python scripts/news_bot.py --once --topics "AI大模型,具身智能,每日财经热点"
# 未传 --topics 时默认：AI大模型,具身智能,每日财经热点（须 1–5 个，英文逗号分隔）
#
# 若开启了「自定义关键词」，请至少包含：小可每日资讯
# ----------------------------------------
